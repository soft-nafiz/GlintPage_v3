{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22",
    "python": "3.12"
  },
  "steps": {
    "build": {
      "commands": [
        "python -m pip install --user -r apps/worker/requirements.txt",
        "cd apps/worker && node -e \"require('./index').verifyPythonBridge().then(()=>console.log('worker preflight ok'))\""
      ]
    }
  },
  "deploy": {
    "startCommand": "cd apps/worker && PDF_PIPELINE=python PYTHON_BIN=python node index.js"
  }
}
