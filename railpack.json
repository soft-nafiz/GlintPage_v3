{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22",
    "python": "3.12"
  },
  "steps": {
    "build": {
      "commands": [
        "python -m venv /app/.venv",
        "/app/.venv/bin/pip install -r apps/worker/requirements.txt",
        "PYTHON_BIN=/app/.venv/bin/python pnpm --filter worker preflight"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd apps/worker && PDF_PIPELINE=python PYTHON_BIN=/app/.venv/bin/python node index.js"
  }
}
